<?xml version="1.0"?>
<package format="3">
  <name>fast_livo2_integration</name>
  <version>0.1.0</version>
  <description>Launch and calibration adapters for FAST-LIVO2 with Hunter SE, Livox MID360, and RealSense D455.</description>
  <maintainer email="z@todo.todo">z</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fast_livo</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
