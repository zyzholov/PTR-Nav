<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="hunter_box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}" />
      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x * x + z * z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x * x + y * y) / 12.0}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="hunter_cylinder_inertia" params="mass radius length axis:=z">
    <inertial>
      <mass value="${mass}" />
      <xacro:if value="${axis == 'x'}">
        <inertia
          ixx="${0.5 * mass * radius * radius}"
          ixy="0.0"
          ixz="0.0"
          iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}"
          iyz="0.0"
          izz="${mass * (3.0 * radius * radius + length * length) / 12.0}" />
      </xacro:if>
      <xacro:if value="${axis == 'y'}">
        <inertia
          ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${0.5 * mass * radius * radius}"
          iyz="0.0"
          izz="${mass * (3.0 * radius * radius + length * length) / 12.0}" />
      </xacro:if>
      <xacro:unless value="${axis == 'x'}">
        <xacro:unless value="${axis == 'y'}">
          <inertia
            ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
            ixy="0.0"
            ixz="0.0"
            iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}"
            iyz="0.0"
            izz="${0.5 * mass * radius * radius}" />
        </xacro:unless>
      </xacro:unless>
    </inertial>
  </xacro:macro>

  <xacro:macro name="hunter_se_robot" params="prefix:=''">
    <xacro:property name="base_mass" value="24.73" />
    <xacro:property name="wheel_mass" value="3.149" />
    <xacro:property name="steer_mass" value="0.80" />
    <xacro:property name="aux_mass" value="0.05" />
    <xacro:property name="wheel_radius" value="0.13" />
    <xacro:property name="wheel_width" value="0.045" />
    <xacro:property name="base_length" value="0.86" />
    <xacro:property name="base_width" value="0.60" />
    <xacro:property name="base_height" value="0.20" />

    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.037414 -0.000373 -0.077128" rpy="0 0 0" />
        <mass value="${base_mass}" />
        <inertia
          ixx="0.123215829336501"
          ixy="-0.00000251201031615063"
          ixz="0.00480100638469038"
          iyy="0.219144715482931"
          iyz="-0.000010329581476775"
          izz="0.313606030126045" />
      </inertial>
      <visual>
        <origin xyz="0.05 0.0 -0.06" rpy="0 0 0" />
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}" />
        </geometry>
        <material name="${prefix}body_grey">
          <color rgba="0.76 0.76 0.76 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0.05 0.0 -0.06" rpy="0 0 0" />
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}fr_steer_left_link">
      <visual>
        <geometry>
          <box size="0.05 0.05 0.05" />
        </geometry>
        <material name="${prefix}dark_grey">
          <color rgba="0.22 0.22 0.22 1.0" />
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.05 0.05 0.05" />
        </geometry>
      </collision>
      <xacro:hunter_box_inertia mass="${steer_mass}" x="0.05" y="0.05" z="0.05" />
    </link>

    <joint name="${prefix}fr_steer_left_joint" type="revolute">
      <origin xyz="0.34058 0.24619 -0.1535" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}fr_steer_left_link" />
      <axis xyz="0 0 1" />
      <limit lower="-0.69" upper="0.69" effort="400" velocity="2.5" />
      <dynamics damping="6.0" friction="1.0" />
    </joint>

    <link name="${prefix}fr_left_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="${prefix}wheel_black">
          <color rgba="0.08 0.08 0.08 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <xacro:hunter_cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}" axis="y" />
    </link>

    <joint name="${prefix}fr_left_joint" type="continuous">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${prefix}fr_steer_left_link" />
      <child link="${prefix}fr_left_link" />
      <axis xyz="0 -1 0" />
      <limit effort="800" velocity="120" />
      <dynamics damping="1.2" friction="0.6" />
    </joint>

    <link name="${prefix}fr_steer_right_link">
      <visual>
        <geometry>
          <box size="0.05 0.05 0.05" />
        </geometry>
        <material name="${prefix}dark_grey_right">
          <color rgba="0.22 0.22 0.22 1.0" />
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.05 0.05 0.05" />
        </geometry>
      </collision>
      <xacro:hunter_box_inertia mass="${steer_mass}" x="0.05" y="0.05" z="0.05" />
    </link>

    <joint name="${prefix}fr_steer_right_joint" type="revolute">
      <origin xyz="0.34219 -0.24619 -0.1535" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}fr_steer_right_link" />
      <axis xyz="0 0 1" />
      <limit lower="-0.69" upper="0.69" effort="400" velocity="2.5" />
      <dynamics damping="6.0" friction="1.0" />
    </joint>

    <link name="${prefix}fr_right_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="${prefix}wheel_black_right">
          <color rgba="0.08 0.08 0.08 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <xacro:hunter_cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}" axis="y" />
    </link>

    <joint name="${prefix}fr_right_joint" type="continuous">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${prefix}fr_steer_right_link" />
      <child link="${prefix}fr_right_link" />
      <axis xyz="0 -1 0" />
      <limit effort="800" velocity="120" />
      <dynamics damping="1.2" friction="0.6" />
    </joint>

    <link name="${prefix}re_left_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="${prefix}wheel_black_rear_left">
          <color rgba="0.10 0.10 0.10 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <xacro:hunter_cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}" axis="y" />
    </link>

    <joint name="${prefix}re_left_joint" type="continuous">
      <origin xyz="-0.2078 0.252 -0.158" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}re_left_link" />
      <axis xyz="0 -1 0" />
      <limit effort="800" velocity="120" />
      <dynamics damping="1.2" friction="0.6" />
    </joint>

    <link name="${prefix}re_right_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="${prefix}wheel_black_rear_right">
          <color rgba="0.10 0.10 0.10 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <xacro:hunter_cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}" axis="y" />
    </link>

    <joint name="${prefix}re_right_joint" type="continuous">
      <origin xyz="-0.2078 -0.252 -0.158" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}re_right_link" />
      <axis xyz="0 -1 0" />
      <limit effort="800" velocity="120" />
      <dynamics damping="1.2" friction="0.6" />
    </joint>

    <link name="${prefix}front_steer_link">
      <visual>
        <geometry>
          <cylinder radius="0.01" length="0.03" />
        </geometry>
        <material name="${prefix}aux_blue">
          <color rgba="0.55 0.70 0.90 1.0" />
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.01" length="0.03" />
        </geometry>
      </collision>
      <xacro:hunter_cylinder_inertia mass="${aux_mass}" radius="0.01" length="0.03" />
    </link>

    <joint name="${prefix}front_steer_joint" type="revolute">
      <origin xyz="0.40792 0.0 -0.085581" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}front_steer_link" />
      <axis xyz="0 0 1" />
      <limit lower="-0.69" upper="0.69" effort="100" velocity="2.5" />
      <dynamics damping="4.0" friction="0.5" />
    </joint>
  </xacro:macro>
</robot>
