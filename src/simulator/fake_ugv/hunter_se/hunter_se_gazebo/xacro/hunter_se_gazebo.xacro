      self_filter_max_y="0.34"
      self_filter_min_z="-0.26"
      self_filter_max_z="0.38"
      scan_samples="${livox_scan_samples}"
      scan_downsample="${livox_scan_downsample}"
      sensor_update_rate="10"
      ray_horizontal_samples="${livox_ray_horizontal_samples}"
      ray_vertical_samples="${livox_ray_vertical_samples}"
      laser_max_range_override="30.0"
      terrain_mode="false"
      terrain_heightmap=""
      terrain_ray_step="0.35">
      <origin xyz="0.18 0.0 0.250" rpy="0 0.436332313 0" />
