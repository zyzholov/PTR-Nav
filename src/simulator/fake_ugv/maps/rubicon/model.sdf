      <visual name="RockPile_visual">
        <geometry>
          <mesh>
            <uri>model://rubicon/meshes/rubicon.dae</uri>
            <scale>1 1 1</scale>
            <submesh>
              <name>RockPile</name>
              <center>false</center>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>model://rubicon/materials/textures/RockPile_Albedo.png</albedo_map>
              <normal_map>model://rubicon/materials/textures/RockPile_Normal.png</normal_map>
              <roughness_map>model://rubicon/materials/textures/RockPile_Roughness.png</roughness_map>
              <metalness>0</metalness>
            </metal>
          </pbr>
          <!-- fallback to script if no PBR support-->
          <script>
            <uri>model://rubicon/materials/scripts/</uri>
            <uri>model://rubicon/materials/textures/</uri>
            <name>UrbanTile/RockPile_Diffuse</name>
          </script>
        </material>
