Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Local Traversability Risk1
        - /Global Plan Marker1
        - /Goal Pose Marker1
        - /Terrain Guidance Path1
        - /SDF Surface1
        - /Overhead Canopy Cloud1
        - /Global Map1
        - /Global Map1/Topic1
        - /Global Map1/Autocompute Value Bounds1
        - /PointCloud21
        - /PointCloud21/Topic1
      Splitter Ratio: 0.5
    Tree Height: 503
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
      - /Chase Camera View1
      - /Autoware Chase View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Global Map
Visualization Manager:
  Class: ""
