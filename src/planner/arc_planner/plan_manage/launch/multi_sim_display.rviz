Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
      Splitter Ratio: 0.5
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.3
      Class: rviz_default_plugins/Grid
      Color: 161; 161; 161
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Line
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep (Number of Odom. Msgs): 200
      Name: Odometry
      Position Tolerance: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /car_0/odometry
      Value: true
      Velocity Tolerance: 0.1
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Marker - Odometry Marker
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /marker
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Marker - Reference Trajectory
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /reference_path
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Marker - Predicted Trajectory
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /predict_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Marker - Following Trajectory
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /following_path
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Path - Optimized Plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visualization/refinedTraj_kinoastar
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Marker - Vehicle History
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vehicle_history
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: PointCloud2 - Laser Scan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /car_0/laser_scan
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud2 - Terrain Cloud
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_cloud
      Value: true
      Decay Time: 0.0
      Max Color: {r: 1, g: 0.8, b: 0.6}
      Min Color: {r: 0.2, g: 0.2, b: 0.2}
      Point Size: 3
      Use rainbow: true
      Use fixed RGB: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud2 - Global Cloud
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_cloud
      Value: true
      Decay Time: 0.0
      Max Color: {r: 0.9, g: 0.9, b: 0.9}
      Min Color: {r: 0.4, g: 0.4, b: 0.4}
      Point Size: 1.5
      Use rainbow: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: PointCloud2 - Map Generator Global Cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_generator/global_cloud
      Value: false
      Max Color: {r: 1, g: 1, b: 1}
      Min Color: {r: 0.5, g: 0.5, b: 0.5}
      Point Size: 2
      Use rainbow: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud2 - Map Generator Local Cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_generator/local_cloud
      Value: true
      Max Color: {r: 0, g: 1, b: 0}
      Min Color: {r: 0, g: 0.5, b: 0}
      Point Size: 1.5
      Use rainbow: false
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Name: Marker - Terrain Normals
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /car_0_terrain_analyzer/normal_map
      Value: false
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Name: Marker - Terrain SDF
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /car_0_terrain_analyzer/sdf_map
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud2 - Elevation Cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /car_0_terrain_analyzer/elevation_cloud
      Value: true
      Decay Time: 0.0
      Max Color: {r: 1, g: 0, b: 0}
      Min Color: {r: 0, g: 0, b: 1}
      Point Size: 2.0
      Use rainbow: true
      Use fixed RGB: false
  Enabled: true
  Global Options:
    Background Color: {r: 48, g: 48, b: 48}
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
      Tool Name: Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Class Name: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Single click pub topic: /clicked_point
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 50
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.785398
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.785398
    Saved Views: []
Window Geometry:
  Displays:
    collapsed: false
  Height: 1016
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1400
