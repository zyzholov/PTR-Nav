Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.42
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
    SyncSource: FAST-LIO Accumulated Map
  - Class: ptr_navigation_rviz/StatusPanel
    Name: Navigation Status
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: false
      Alpha: 0.12
      Cell Size: 1
      Color: 91; 104; 112
      Line Style:
        Line Width: 0.02
        Value: Line
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: -0.015
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: false
    - Class: rviz_default_plugins/TF
      Name: TF Frames
      Enabled: false
      Frame Timeout: 5
      Marker Scale: 0.4
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Terrain Elevation
      Enabled: false
      Alpha: 0.72
      Autocompute Intensity Bounds: false
      Autocompute Value Bounds:
        Max Value: 2
        Min Value: -1
        Value: false
      Axis: Z
      Channel Name: rgb
      Color: 202; 174; 125
      Color Transformer: RGB8
      Decay Time: 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.045
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /car_0_terrain_analyzer/elevation_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: 地形风险分量与原始占据（灰色未知）
      Enabled: true
      Namespaces:
        terrain_surface: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /car_0_terrain_analyzer/terrain_surface
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Measured Elevation Surface
      Enabled: false
      Namespaces:
        measured_elevation: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_display/elevation_surface
      Value: false
    - Class: rviz_default_plugins/Marker
      Name: 原始障碍轮廓（不含车身包络）
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /car_0_terrain_analyzer/terrain_surface/occupied_cells
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: 整车姿态风险面（含车身包络，仅诊断）
      Enabled: false
      Namespaces:
        body_pose_risk_surface: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_display/body_pose_risk_surface
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Probability Legend
      Enabled: false
      Namespaces:
        probability_legend: true
      Queue Size: 1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /car_0_terrain_analyzer/terrain_surface/legend
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: 整车姿态风险点（当前航向，仅诊断）
      Enabled: false
      Alpha: 0.92
      Autocompute Intensity Bounds: false
      Autocompute Value Bounds:
        Max Value: 1
        Min Value: 0
        Value: false
      Axis: Z
      Channel Name: rgb
      Color: 50; 190; 145
      Color Transformer: RGB8
      Decay Time: 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.075
      Style: Spheres
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /car_0_terrain_analyzer/risk_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Measured Height
      Enabled: false
      Alpha: 0.95
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
      Style: Flat Squares
      Size (m): 0.17
      Size (Pixels): 3
      Selectable: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_display/measured_height
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Predicted Height (Candidates)
      Enabled: false
      Alpha: 0.95
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
      Style: Spheres
      Size (m): 0.075
      Size (Pixels): 3
      Selectable: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_display/predicted_height
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: GP Height (Navigation Qualified)
      Enabled: false
      Alpha: 0.95
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
      Style: Flat Squares
      Size (m): 0.14
      Size (Pixels): 3
      Selectable: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_display/navigation_prediction
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Initial Assumed Height (Simulation)
      Enabled: true
      Alpha: 0.75
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
      Style: Flat Squares
      Size (m): 0.17
      Size (Pixels): 3
      Selectable: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_display/startup_height
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Measured / GP Sources
      Enabled: false
      Alpha: 0.95
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
      Style: Flat Squares
      Size (m): 0.17
      Size (Pixels): 3
      Selectable: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_display/sources
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Prediction Support (Unqualified)
      Enabled: false
      Alpha: 0.35
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
      Style: Points
      Size (m): 0.025
      Size (Pixels): 2
      Selectable: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_display/prediction_support
      Value: false
    - Class: rviz_default_plugins/Map
      Name: Live Obstacles
      Enabled: false
      Alpha: 0.55
      Color Scheme: costmap
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_nav/live_obstacles
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Terrain Nav Path
      Enabled: true
      Alpha: 1
      Buffer Length: 1
      Color: 75; 214; 224
      Head Diameter: 0.18
      Head Length: 0.1
      Length: 0.18
      Line Style: Billboards
      Line Width: 0.045
      Offset:
        X: 0
        Y: 0
        Z: 0.07
      Pose Color: 75; 214; 224
      Pose Style: None
      Radius: 0.02
      Shaft Diameter: 0.065
      Shaft Length: 0.05
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_nav/path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Planner Reference
      Enabled: false
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /reference_path
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Actual Odometry Track (Gold)
      Enabled: true
      Alpha: 0.95
      Buffer Length: 1
      Color: 238; 191; 91
      Line Style: Billboards
      Line Width: 0.035
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_nav/executed_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Tracking Status And Height Model
      Enabled: true
      Namespaces:
        tracking_error: true
        tracking_status: false
        command_projection: true
        height_model: true
        height_model_label: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_nav/presentation
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Mission Goal (Fixed Gold)
      Enabled: true
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_nav/active_goal
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Rolling Subgoal (Cyan)
      Enabled: true
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_nav/local_goal
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Vehicle Model
      Enabled: true
      Namespaces:
        vehicle_footprint: true
        vehicle_heading: true
        vehicle_lidar_hint: true
        vehicle_mesh: true
        vehicle_shadow: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vehicle_model
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: FAST-LIO Odometry
      Enabled: false
      Angle Tolerance: 0.15
      Keep: 1
      Position Tolerance: 0.2
      Shape:
        Alpha: 0.9
        Axes Length: 0.55
        Axes Radius: 0.035
        Color: 232; 183; 76
        Head Length: 0.18
        Head Radius: 0.07
        Shaft Length: 0.5
        Shaft Radius: 0.025
        Value: Arrow
      Covariance:
        Orientation:
          Alpha: 0.15
          Color: 232; 183; 76
          Color Style: Unique
          Frame: Local
          Offset: 0
          Scale: 1
          Value: false
        Position:
          Alpha: 0.15
          Color: 232; 183; 76
          Scale: 1
          Value: false
        Value: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /Odometry
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: FAST-LIO Accumulated Map
      Enabled: true
      Alpha: 0.40
      Autocompute Intensity Bounds: false
      Autocompute Value Bounds:
        Max Value: 2
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Color: 166; 195; 214
      Color Transformer: RGB8
      Decay Time: 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_display/lidar_map
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Live LiDAR Returns (Range Color)
      Enabled: true
      Alpha: 0.16
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
      Size (Pixels): 1
      Size (m): 0.025
      Style: Points
      Selectable: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /terrain_display/lidar_returns
      Use Fixed Frame: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 16; 24; 32
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
    Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Local Terrain Follow
      Near Clip Distance: 0.01
      Pitch: 0.85
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 0.72
    Saved:
      - Class: rviz_default_plugins/Orbit
        Distance: 19
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Focal Point:
          X: 0
          Y: 0
          Z: 0.15
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Terrain Overview
        Near Clip Distance: 0.01
        Pitch: 0.70
        Target Frame: map
        Value: Orbit (rviz)
        Yaw: 0.72
      - Class: rviz_default_plugins/ThirdPersonFollower
        Distance: 7
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Focal Point:
          X: 0
          Y: 0
          Z: 0.65
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Vehicle Follow
        Near Clip Distance: 0.01
        Pitch: 0.5
        Target Frame: base_link
        Value: ThirdPersonFollower (rviz_default_plugins)
        Yaw: 3.14159
Window Geometry:
  Displays:
    collapsed: true
  Height: 900
  Hide Right Dock: false
  Hide Left Dock: false
  Width: 1600
  X: 60
  Y: 60
  QMainWindow State: 
