<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsgp_bgk_se2</name>
  <version>0.1.0</version>
  <description>FSGP-BGK and SEB traversability enhancement for SE2Grid terrain maps.</description>
  <maintainer email="z@example.com">z</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>se2_grid_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>terrain_analyzer</exec_depend>
  <exec_depend>terrain_nav</exec_depend>
  <exec_depend>se2_grid_converter</exec_depend>
  <exec_depend>vehicle_visualizer</exec_depend>
  <exec_depend>fake_ugv</exec_depend>
  <exec_depend>plan_manage</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
